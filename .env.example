MONGODB_URI=mongodb://127.0.0.1:27017/secure-notes
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
PORT=4000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Proxies allowed to set X-Forwarded-For (ignored on Vercel, which provides the client IP itself)
TRUST_PROXY=loopback
# Set to false to disable the Swagger UI at /api/docs
SWAGGER_ENABLED=true
