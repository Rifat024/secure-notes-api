{
  "name": "secure-notes-api",
  "version": "1.0.0",
  "description": "Secure note-taking REST API built with NestJS: JWT auth, role-based access control, brute-force protection, and index-backed MongoDB queries.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "seed": "ts-node src/cli/seed.ts",
    "explain": "ts-node src/cli/explain.ts",
    "e2e": "node scripts/e2e.js",
    "deploy": "bash scripts/deploy.sh",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": [
            "ts-jest",
            {
              "tsconfig": {
                "allowJs": true
              }
            }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(content-disposition)/)"
        ],
        "setupFiles": [
          "<rootDir>/test/setup-logger.ts"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/**/*.e2e-spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/setup-env.ts",
          "<rootDir>/test/setup-logger.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": [
            "ts-jest",
            {
              "tsconfig": {
                "allowJs": true
              }
            }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(content-disposition)/)"
        ]
      }
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.5",
    "mongoose": "^8.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "secure-json-parse": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fastify": "$fastify"
  }
}
